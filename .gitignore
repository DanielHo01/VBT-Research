# Models — keep best.onnx and yolo11_plate.onnx
models/yolo11_plate.onnx   # Active detector (may be overwritten by best.onnx)
models/best.onnx            # Colab-trained experiment output ✅ tracked
models/best.pt              # Colab-trained weights ✅ tracked
models/github_downloads/     # Stale experimental downloads
yolo11n.pt                   # Pretrained YOLOv11 nano (large)
sam2_t.pt                    # SAM2 pretrained checkpoint (large)
yolov8n.pt                   # YOLOv8 nano pretrained weights

# Datasets — too large for git
datasets/
!datasets/.gitkeep  # Keep dir marker
datasets/weightlifting-plates/
datasets/owlvit_pseudo/
datasets/interactive_labels/
datasets/barbell_dataset/   # 728 annotated frames (too large)

# Archives — old experiment debris (但 vbtcore 历史模块须可追踪，供 1 个 release 周期回滚)
_archive/
!_archive/vbtcore_history/
!_archive/vbtcore_history/*.py
archives/

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Virtual environments
.venv/
venv/

# IDE
.vscode/
.idea/

# Windows
*.tmp
*.log

# Validation raw videos — committed to git (small enough at ~100 MB total)
# 34 mp4 clips under validation/dataset_benchmark/raw_videos/
# Held-out set (see docs/HOLDOUT.md) lives under validation/holdout/ (same convention)

# YOLO/EzYOLO training outputs
runs/
ezyolo_runs/

# Phase0 coverage reports — exclude large overlay images, keep small JSON metrics
validation/reports/coverage_phase0/
validation/reports/coverage_phase0/**/
validation/reports/coverage_phase0/*.jpg
validation/reports/coverage_phase0/*.png
validation/reports/coverage_phase0/*.mp4

# v2/v4 are also generated visualizations (only json metrics remain)
validation/reports/coverage_phase0_v2/*.jpg
validation/reports/coverage_phase0_v2/*.png
validation/reports/coverage_phase0_v4/*.jpg
validation/reports/coverage_phase0_v4/*.png
validation/reports/coverage_phase0_v4/cgap_inspect/

# Benchmark JSON outputs that are regenerated by scripts (md remains tracked)
validation/reports/BENCHMARK_v0.json
validation/reports/BENCHMARK_v1.json
validation/reports/BENCHMARK_v2.json
validation/reports/BENCHMARK_v3.json
validation/reports/BENCHMARK_v6.json

# Tooling caches
.ruff_cache/
.pi/

# Source videos for training data extraction (large raw files)
videos/




